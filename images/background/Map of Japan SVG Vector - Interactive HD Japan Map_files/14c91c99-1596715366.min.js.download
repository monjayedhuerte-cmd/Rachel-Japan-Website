return customEvent},createAndDispatchEvent:function(obj,event,params){var customEvent=methods.createCustomEvent(event,params);if(customEvent){obj.dispatchEvent(customEvent)}}};stiBoxSingleSelector='sti-box-s-'+methods.stringToId(opts.selector);if(!opts.is_mobile){if(opts.position!=='image_hover'){var i=0;this.each(function(){var el=methods.detectRightContainer(this);if(el&&!el.next().hasClass('sti')){do{i++}while($('#sti-box-'+i).length>0);currentImageElements[i]=el;el.after('<div data-el="'+i+'" id="sti-box-'+i+'" class="sti sti-top style-flat-small sti-inside" style="display: none;"><div class="sti-share-box">'+methods.shareButtons()+'</div></div>');methods.showShare(el,'#sti-box-'+i,!0)}})}else{if(!$('#'+stiBoxSingleSelector).length){$('body').append('<div id="'+stiBoxSingleSelector+'" class="sti sti-top sti-hover style-flat-small" style="display: none;"><div class="sti-share-box">'+methods.shareButtons()+'</div></div>')}
